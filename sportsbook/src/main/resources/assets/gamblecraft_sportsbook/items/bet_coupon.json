{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "won",
        "model": {
          "type": "minecraft:model",
          "model": "gamblecraft_sportsbook:item/bet_coupon_won"
        }
      },
      {
        "when": "lost",
        "model": {
          "type": "minecraft:model",
          "model": "gamblecraft_sportsbook:item/bet_coupon_lost"
        }
      },
      {
        "when": "void",
        "model": {
          "type": "minecraft:model",
          "model": "gamblecraft_sportsbook:item/bet_coupon_void"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "gamblecraft_sportsbook:item/bet_coupon"
    }
  }
}
